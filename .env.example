# Supabase (SDK oficial @supabase/supabase-js)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_anon_o_service_role_key

# Opcional: Connection string de PostgreSQL en Supabase (solo para ejecutar npm run init-db y crear las tablas automáticamente)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.tu-proyecto.supabase.co:5432/postgres

# Server
PORT=3001

# Backoffice (cambiar en producción)
BACKOFFICE_KEY=CAMBIAR_ESTA_CLAVE_EN_PRODUCCION
